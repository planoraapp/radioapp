  "context_rules": {
    "description": "Regras de contexto para melhorar a compreensão da IA",
    "medication_context": [
      "Quando o paciente menciona 'remédio para dor', provavelmente se refere a analgésicos como paracetamol ou ibuprofeno",
      "Quando menciona 'remédio para pressão', se refere a anti-hipertensivos como losartana ou enalapril",
      "Quando menciona 'remédio para diabetes', se refere a antidiabéticos como metformina ou gliclazida",
      "Quando menciona 'antibiótico', pode se referir a amoxicilina, azitromicina ou ciprofloxacino",
      "Doses são geralmente mencionadas em mg, ml ou UI",
      "Frequência é mencionada como 'vezes ao dia', 'de 8 em 8 horas', etc."
    ],
    "name_context": [
      "Nomes brasileiros frequentemente incluem Maria, José, João, Ana, Francisco",
      "Muitos nomes têm diminutivos: João → Jão, José → Zé, Maria → Mariazinha",
      "Nomes compostos são comuns: João Pedro, Ana Paula, Maria José",
      "Surnames comuns: Silva, Santos, Oliveira, Souza, Rodrigues",
      "Nomes indígenas ou africanos são comuns no Nordeste",
      "Nomes italianos são comuns no Sul (Rosa, Antonio, Giovanni)"
    ],
    "medical_context": [
      "Quando mencionam 'pressão alta', se refere a hipertensão arterial",
      "Quando mencionam 'infarto', se refere a infarto agudo do miocárdio",
      "Quando mencionam 'derrame', se refere a acidente vascular encefálico",
      "Quando mencionam 'coluna', pode se referir a hérnia de disco ou escoliose",
